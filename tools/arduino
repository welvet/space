#!/usr/bin/env python3

import argparse
import json
import shutil
import subprocess
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
FIRMWARE = ROOT / "firmware"


def config():
    return json.loads((ROOT / "arduino.json").read_text())


def quoted(value):
    return json.dumps(value)


def generated(config):
    switches = config["switches"]
    readers = config["readers"]
    switch_values = switches or [
        {"id": "", "pin": 0, "straight": 0, "diverge": 0}
    ]
    reader_values = readers or [
        {"id": "", "ss_pin": 0, "read_timeout_ms": 1, "removal_delay_ms": 1}
    ]

    lines = [
        "#ifndef GENERATED_CONFIG_H",
        "#define GENERATED_CONFIG_H",
        '#include "config_types.h"',
        f"constexpr char HUB_ID[] = {quoted(config['hub_id'])};",
        f"constexpr char BACKEND_HOST[] = {quoted(config['backend_host'])};",
        f"constexpr uint16_t BACKEND_PORT = {config['backend_port']};",
        f"constexpr char WIFI_SSID[] = {quoted(config['wifi_ssid'])};",
        f"constexpr char WIFI_PASSWORD[] = {quoted(config['wifi_password'])};",
        f"constexpr unsigned long SERIAL_BAUDRATE = {config['baudrate']};",
        f"constexpr unsigned long SERVO_SETTLE_MS = {config['servo_settle_ms']};",
        f"constexpr unsigned long RECONNECT_MS = {config['reconnect_ms']};",
        f"constexpr int SWITCH_COUNT = {len(switches)};",
        f"constexpr int SWITCH_STORAGE_SIZE = {max(1, len(switches))};",
        "const SwitchConfig SWITCHES[SWITCH_STORAGE_SIZE] = {",
    ]
    lines += [
        f"  {{{quoted(item['id'])}, {item['pin']}, "
        f"{item['straight']}, {item['diverge']}}},"
        for item in switch_values
    ]
    lines += [
        "};",
        f"constexpr int READER_COUNT = {len(readers)};",
        f"constexpr int READER_STORAGE_SIZE = {max(1, len(readers))};",
        "const ReaderConfig READERS[READER_STORAGE_SIZE] = {",
    ]
    lines += [
        f"  {{{quoted(item['id'])}, {item['ss_pin']}, "
        f"{item['read_timeout_ms']}, {item['removal_delay_ms']}}},"
        for item in reader_values
    ]
    lines += ["};", "#endif", ""]
    return "\n".join(lines)


def sketch(config, directory):
    path = Path(directory) / "firmware"
    shutil.copytree(FIRMWARE, path)
    (path / "generated_config.h").write_text(generated(config))
    return path


def run(command):
    print("→", " ".join(map(str, command)), flush=True)
    subprocess.run(command, check=True)


def build(upload=False):
    settings = config()
    with tempfile.TemporaryDirectory(prefix="space-firmware-") as directory:
        path = sketch(settings, directory)
        run(["arduino-cli", "compile", "--fqbn", settings["fqbn"], path])
        if upload:
            run([
                "arduino-cli",
                "upload",
                "-p",
                settings["port"],
                "--fqbn",
                settings["fqbn"],
                path,
            ])


def monitor():
    settings = config()
    run([
        "arduino-cli",
        "monitor",
        "-p",
        settings["port"],
        "--config",
        f"baudrate={settings['baudrate']}",
    ])


parser = argparse.ArgumentParser()
parser.add_argument("command", choices=("compile", "install", "monitor"))
command = parser.parse_args().command
if command == "compile":
    build()
elif command == "install":
    build(upload=True)
else:
    monitor()
